{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "VITE_APP_VERSION=${nextRelease.version} npm run build && cd dist && zip -qr ../emudev-${nextRelease.version}.zip .",
        "successCmd": "echo \"version=${nextRelease.version}\" >> \"$GITHUB_OUTPUT\""
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [{ "path": "emudev-*.zip", "label": "Web build (dist)" }]
      }
    ]
  ]
}
